<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- WebView Container (Fills entire screen behind the toolbar) -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Navigation / URL Bar Overlay -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E61E1E1E"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:visibility="visible">

        <!-- Navigation Buttons -->
        <Button
            android:id="@+id/btnBack"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/tv_button_selector"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:focusable="true" />

        <Button
            android:id="@+id/btnForward"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tv_button_selector"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:focusable="true" />

        <Button
            android:id="@+id/btnHome"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tv_button_selector"
            android:text="🏠"
            android:focusable="true" />

        <Button
            android:id="@+id/btnReload"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tv_button_selector"
            android:text="🔄"
            android:focusable="true" />

        <!-- URL Input Field -->
        <EditText
            android:id="@+id/etUrlBar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_edittext_selector"
            android:hint="Enter URL or search..."
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:focusable="true" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/tv_button_selector"
            android:text="GO"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:focusable="true" />

        <!-- Utility Toggles -->
        <Button
            android:id="@+id/btnDesktop"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/tv_button_selector"
            android:text="Desktop"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true" />

        <!-- Settings Button (Opens Options Dialog) -->
        <Button
            android:id="@+id/btnSettings"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tv_button_selector"
            android:text="⚙"
            android:focusable="true" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tv_button_selector"
            android:text="⬇"
            android:focusable="true" />

    </LinearLayout>

    <!-- Mode HUD Display -->
    <TextView
        android:id="@+id/tvModeHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="#CC000000"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="10dp"
        android:text="Mode: Scroll" />

</RelativeLayout>
