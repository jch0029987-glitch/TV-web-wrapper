<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Native Sidebar Menu -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:background="#121212"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV Wrapper"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Facebook"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMessenger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Messenger"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="X"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Map Button"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Check Updates"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDesktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Desktop Mode"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Mobile Mode" />

    </LinearLayout>

    <!-- WebView Container with Floating Mode HUD Overlay -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.example.messengerwrapper.InteractiveWebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Mode HUD Indicator -->
        <TextView
            android:id="@+id/tvModeHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="#AA000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Mode: Scroll"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </FrameLayout>

</LinearLayout>
